# ==============================================================================
# Engine Predictive Maintenance - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local execution.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Optional: Hugging Face Token (only required if synchronizing with Hugging Face Hub / Spaces)
# HF_TOKEN=hf_your_personal_access_token_here

# Optional: Logging Configuration
# LOG_LEVEL=INFO
